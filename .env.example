# Copy to .env and adjust. Used by docker-compose.
JWT_SECRET=change-me-in-prod-vts-secret

# External OSINT is allowed only for the normal trusted lab profile. The
# lifecycle test overlay always overrides this to false and targets only
# the internal service named vuln-target.
RECON_EXTERNAL_SOURCES_ENABLED=true

# Lifecycle attempt deadlines (seconds; every value must be 1..86400).
WORK_BOOTSTRAP_TIMEOUT_SECONDS=90
WORK_HTTP_PROBE_TIMEOUT_SECONDS=60
WORK_PORT_TIMEOUT_SECONDS=30
WORK_FUZZ_TIMEOUT_SECONDS=45
WORK_TEMPLATE_TIMEOUT_SECONDS=120
WORK_SPECIALIZED_TIMEOUT_SECONDS=60
WORK_SAFE_VERIFY_TIMEOUT_SECONDS=30
WORK_EXECUTE_TIMEOUT_SECONDS=30
WORK_HEARTBEAT_SECONDS=5
WORK_LEASE_TTL_SECONDS=15
WORK_RECLAIM_IDLE_SECONDS=20
WORK_MAX_ATTEMPTS=3
WORK_RETRY_BACKOFF_SECONDS=1,5,15
TECHNICAL_WATCHDOG_SECONDS=7200
APPROVAL_DEADLINE_SECONDS=86400
TERMINAL_RETENTION_SECONDS=604800
DEDUPE_RETENTION_SECONDS=691200

# Host interface the published ports bind to. Keep 127.0.0.1 unless the lab
# network is trusted; 0.0.0.0 exposes every backend and Redis to the network.
VTS_BIND_ADDRESS=127.0.0.1

# Optional host-port overrides. Defaults preserve the existing lab topology.
REDIS_HOST_PORT=6379
GATEWAY_HOST_PORT=8000
SCOPE_HOST_PORT=8001
ORCHESTRATOR_HOST_PORT=8002
DASHBOARD_HOST_PORT=8080
RECON_SUBDOMAIN_HOST_PORT=8011
RECON_HTTPPROBE_HOST_PORT=8012
RECON_PORTFUZZ_HOST_PORT=8013
SCAN_ENGINE_HOST_PORT=8021
SCAN_SPECIALIZED_HOST_PORT=8022
VERIFICATION_HOST_PORT=8023
VULN_TARGET_HOST_PORT=8090

# Optional scan-finished webhook (OFF when WEBHOOK_URL is empty). The host MUST also be
# listed in WEBHOOK_ALLOWED_HOSTS (comma separated). Only a summary is sent: IDs, status, counters.
WEBHOOK_URL=
WEBHOOK_ALLOWED_HOSTS=
